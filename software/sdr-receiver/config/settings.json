{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "max_audio_clients": 4
  },
  "receiver": {
    "device_index": 0,
    "ppm": 0,
    "gains": [0.0, 0.9, 1.4, 2.7, 3.7, 7.7, 8.7, 12.5, 14.4, 15.7, 16.6, 19.7, 20.7, 22.9, 25.4,
              28.0, 29.7, 32.8, 33.8, 36.4, 37.2, 38.6, 40.2, 42.1, 43.4, 43.9, 44.5, 48.0, 49.6],
    "usb_power_cycle": ["sudo", "-n", "uhubctl", "-l", "1-1", "-p", "2", "-a", "cycle", "-d", "3"],
    "usb_settle_s": 5
  },
  "modes": {
    "nfm": {"label": "NFM"},
    "wfm": {"label": "WFM"}
  },
  "bands": {
    "vhf": {"label": "2 m amateur", "min_mhz": 144.0, "max_mhz": 146.0, "mode": "nfm",
            "default_mhz": 145.5, "steps_khz": [12.5, 25, 6.25, 100, 1000], "squelch_db": -25, "gain": 40.2},
    "uhf": {"label": "70 cm amateur", "min_mhz": 430.0, "max_mhz": 440.0, "mode": "nfm",
            "default_mhz": 433.5, "steps_khz": [12.5, 25, 6.25, 100, 1000], "squelch_db": -52, "gain": 40.2},
    "fm":  {"label": "FM broadcast", "min_mhz": 87.5, "max_mhz": 108.0, "mode": "wfm",
            "default_mhz": 104.0, "steps_khz": [100, 50, 1000], "squelch_db": null, "gain": 22.9}
  },
  "autostart": true,
  "panel": {
    "_doc": "Front panel (panel.py). BCM pins = hardware/lib/contract.py PI_BCM. rest: A/B states at a detent, (0,3) = KY-040.",
    "gpiochip": 0,
    "poll_s": 0.001,
    "state_poll_s": 0.1,
    "debounce_s": 0.02,
    "long_press_s": 1.0,
    "knob_steps": {"volume": 5, "squelch_db": 2},
    "encoders": {
      "volume":  {"a": 5,  "b": 6,  "rest": [0, 3], "invert": false},
      "squelch": {"a": 12, "b": 13, "rest": [0, 3], "invert": false},
      "tune":    {"a": 22, "b": 23, "rest": [0, 3], "invert": false},
      "menu":    {"a": 24, "b": 25, "rest": [0, 3], "invert": false}
    },
    "buttons": {
      "vol_push":  {"pin": 16, "press": "mute"},
      "sql_push":  {"pin": 19, "press": "monitor"},
      "tune_push": {"pin": 20, "press": "step_next"},
      "menu_push": {"pin": 21, "press": "ui:push"},
      "scan":      {"pin": 17, "press": "scan"},
      "manual":    {"pin": 4,  "press": "manual"},
      "q1":        {"pin": 26, "press": null},
      "q2":        {"pin": 18, "press": "preset:v-145725"},
      "back":      {"pin": 7,  "press": "ui:back"}
    },
    "oled": {"i2c_bus": 1, "addr": "0x3C", "rotate": 0},
    "leds": {"scan": 14, "sig": 15, "man": 8, "2m": 9, "70cm": 10, "fm": 11}
  },
  "band_order": ["vhf", "uhf", "fm"],
  "initial_band": "fm",
  "squelch_min_db": -90,
  "squelch_max_db": 0,
  "scan": {
    "settle_s": 0.3,
    "dwell_s": 0.5,
    "hang_s": 2.0,
    "hold_s": 5.0
  }
}
